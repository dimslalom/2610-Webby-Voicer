{
  "name": "webby-voicer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/stage-ffmpeg-core.mjs",
    "dev": "vite",
    "prebuild": "node scripts/stage-ffmpeg-core.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",

    "dev:worker": "wrangler dev --local",
    "test:room": "node scripts/smoke-room.mjs"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
